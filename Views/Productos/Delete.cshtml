@model Producto
@{
    ViewData["Title"] = "Eliminar producto";
}

<section class="row justify-content-center py-4" aria-labelledby="titulo-eliminar">
    <article class="col-12 col-md-9 col-lg-6 card shadow-sm border-danger">
        <header class="card-header bg-danger text-white">
            <h1 id="titulo-eliminar" class="h4 mb-0">Eliminar producto</h1>
        </header>

        <section class="card-body p-4">
            <p role="alert">¿Está seguro de que desea eliminar este producto? Esta acción no se puede deshacer.</p>

            <dl class="row mb-0">
                <dt class="col-sm-4">Nombre</dt>
                <dd class="col-sm-8">@Model.Nombre</dd>

                <dt class="col-sm-4">Categoría</dt>
                <dd class="col-sm-8">@Model.Categoria</dd>

                <dt class="col-sm-4">Precio</dt>
                <dd class="col-sm-8">@Model.Precio.ToString("C")</dd>

                <dt class="col-sm-4">Stock</dt>
                <dd class="col-sm-8 mb-0">@Model.Stock</dd>
            </dl>
        </section>

        @* Se elimina con POST para evitar borrados accidentales. *@
        <form asp-action="Delete" method="post" class="card-footer d-flex justify-content-end gap-2">
            <input type="hidden" asp-for="Id" />
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-danger">Sí, eliminar</button>
        </form>
    </article>
</section>
