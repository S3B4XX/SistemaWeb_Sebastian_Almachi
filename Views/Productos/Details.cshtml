@model Producto
@{
    ViewData["Title"] = "Detalle del producto";
}

<section class="row justify-content-center py-4" aria-labelledby="titulo-detalle">
    <article class="col-12 col-md-9 col-lg-6 card shadow-sm border-0">
        <header class="card-header">
            <h1 id="titulo-detalle" class="h4 mb-0">@Model.Nombre</h1>
        </header>

        <dl class="row card-body p-4 mb-0">
            <dt class="col-sm-4">Categoría</dt>
            <dd class="col-sm-8">@Model.Categoria</dd>

            <dt class="col-sm-4">Precio</dt>
            <dd class="col-sm-8">@Model.Precio.ToString("C")</dd>

            <dt class="col-sm-4">Stock</dt>
            <dd class="col-sm-8">@Model.Stock</dd>

            <dt class="col-sm-4">Descripción</dt>
            <dd class="col-sm-8 mb-0">@(Model.Descripcion ?? "Sin descripción")</dd>
        </dl>

        <footer class="card-footer d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
        </footer>
    </article>
</section>
