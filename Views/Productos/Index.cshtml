@model IEnumerable<Producto>
@{
    ViewData["Title"] = "Productos";
}

@* Vista de presentación: solo muestra los datos que le entrega el controlador. *@
<header class="d-flex justify-content-between align-items-center my-4">
    <h1 class="h3 mb-0">Productos</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo producto</a>
</header>

@if (TempData["Mensaje"] is string mensaje)
{
    <aside class="alert alert-success" role="status">@mensaje</aside>
}

@if (!Model.Any())
{
    <p class="alert alert-info" role="status">Todavía no hay productos registrados.</p>
}
else
{
    <section class="table-responsive" aria-label="Listado de productos">
        <table class="table table-striped table-hover align-middle">
            <caption class="visually-hidden">Lista de productos registrados</caption>
            <thead>
                <tr>
                    <th scope="col">Nombre</th>
                    <th scope="col">Categoría</th>
                    <th scope="col" class="text-end">Precio</th>
                    <th scope="col" class="text-end">Stock</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var producto in Model)
                {
                    <tr>
                        <td>@producto.Nombre</td>
                        <td>@producto.Categoria</td>
                        <td class="text-end">@producto.Precio.ToString("C")</td>
                        <td class="text-end">@producto.Stock</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@producto.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@producto.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@producto.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}
