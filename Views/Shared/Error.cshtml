@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">Ocurrió un error al procesar su solicitud.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>ID de la solicitud:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Modo de desarrollo</h3>
<p>
    Al cambiar al entorno <strong>Development</strong> se mostrará más información detallada sobre el error.
</p>
<p>
    <strong>El entorno Development no debe activarse en aplicaciones publicadas.</strong>
    Puede mostrar información sensible de las excepciones a los usuarios finales.
    Para depurar en su equipo, active el entorno <strong>Development</strong> configurando la variable
    <strong>ASPNETCORE_ENVIRONMENT</strong> con el valor <strong>Development</strong> y reinicie la aplicación.
</p>
